{
  "name": "editmamei",
  "version": "1.10.2",
  "private": true,
  "description": "Photoshop and GIMP MCP server for AI photo editing, layer by layer with real tools",
  "mcpName": "io.github.editmamei/editmamei-photoshop-mcp",
  "editmamei": {
    "fixesByVersion": {
      "1.10.2": ["ps_relight"],
      "1.9.3": ["gimp_text"],
      "1.9.1": ["ps_replace_sky"],
      "1.9.0": ["ps_save_psd"]
    }
  },
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "editmamei": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICES.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:100})\"",
    "build": "tsc",
    "postbuild": "tsx scripts/build-skill-zip.ts && tsx scripts/build-go-core-dev.ts && tsx scripts/copy-models.ts && tsx scripts/copy-gimp-bridge.ts",
    "build:ce": "tsx scripts/build-ce.ts",
    "build:mcpb": "tsx scripts/build-mcpb.ts",
    "docs:feature-names": "tsx scripts/generate-feature-names.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:docs": "vitest run tests/integration/archived-docs-guard.test.ts tests/integration/feature-names-doc.test.ts tests/integration/macos-floor-sync.test.ts tests/integration/node-floor-sync.test.ts tests/integration/privacy-disclosure.test.ts tests/integration/pro-features-drift-guard.test.ts tests/integration/readme-leak-guard.test.ts tests/unit/tracked-files.test.ts",
    "test:gimp": "vitest run tests/gimp-live",
    "test:gimp:timing": "vitest run tests/gimp-live/large-image-timing.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "photoshop",
    "photoshop-mcp",
    "adobe",
    "automation",
    "photoshop-automation",
    "ai",
    "ai-photo-editing",
    "photoshop-assistant",
    "model-context-protocol",
    "image-editing",
    "batch-editing",
    "claude",
    "editmamei",
    "gimp",
    "gimp-mcp",
    "photo-editing",
    "photo-editor",
    "image-editor",
    "retouching",
    "photo-retouching",
    "ai-image-editing",
    "color-grading"
  ],
  "author": "Editmamei (https://editmamei.com)",
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/editmamei/editmamei.git"
  },
  "homepage": "https://editmamei.com",
  "bugs": {
    "url": "https://github.com/editmamei/editmamei/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "adm-zip": "0.6.1",
    "jpeg-js": "0.4.4",
    "onnxruntime-web": "1.31.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  }
}
